# Optional visit counting for the static site.
# Leave blank to keep analytics off.
# The production values live in .env.production (Umami Cloud); this file is a template.

# Umami: tracks each Vue route (chapter / gallery) as its own page.
# Skipped on localhost / 127.0.0.1.
# VITE_UMAMI_WEBSITE_ID=
# VITE_UMAMI_SCRIPT_URL=https://cloud.umami.is/script.js

# Cloudflare Web Analytics beacon token (overall visits; SPA hops are weak).
# VITE_CF_BEACON_TOKEN=
